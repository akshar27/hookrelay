# Copy to .env. Defaults match `make up` (Postgres on host port 5435).

HOOKRELAY_ENV=development
HOOKRELAY_HTTP_ADDR=:8080
HOOKRELAY_DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5435/hookrelay?sslmode=disable

# Guards every admin / query / dashboard route
HOOKRELAY_ADMIN_TOKEN=dev-admin-token-change-me

# 32 random bytes, base64 — seals endpoint signing secrets at rest (M2+).
# Generate: openssl rand -base64 32
HOOKRELAY_SECRET_KEY=

# Allow http:// (not https) endpoint URLs — local testing only
HOOKRELAY_ALLOW_INSECURE_ENDPOINTS=false
